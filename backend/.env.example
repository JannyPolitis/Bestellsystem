# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Admin-Panel Passwort - UNBEDINGT auf ein eigenes, starkes Passwort aendern!
# Enthaelt der Wert ein #, unbedingt in Anfuehrungszeichen setzen (sonst schneidet
# dotenv beim Laden alles ab dem # als "Kommentar" ab):
#   ADMIN_PASSWORT="meinPasswort#123"
ADMIN_PASSWORT=AENDERE_MICH

# Session-Geheimnis - UNBEDINGT auf einen langen zufaelligen String aendern!
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=AENDERE_MICH
