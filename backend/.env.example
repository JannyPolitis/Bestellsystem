# Demo-Modus: auf false setzen wenn PayPal eingerichtet ist
DEMO_MODUS=true

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# PayPal - Trage hier deine PayPal Developer Zugangsdaten ein
# Sandbox (Test): https://developer.paypal.com -> Apps & Credentials -> Create App
PAYPAL_CLIENT_ID=DEIN_PAYPAL_CLIENT_ID_HIER
PAYPAL_CLIENT_SECRET=DEIN_PAYPAL_CLIENT_SECRET_HIER

# Fuer echte Zahlungen aendern auf: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Admin-Panel Passwort - UNBEDINGT auf ein eigenes, starkes Passwort aendern!
ADMIN_PASSWORT=AENDERE_MICH

# Session-Geheimnis - UNBEDINGT auf einen langen zufaelligen String aendern!
# Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=AENDERE_MICH
